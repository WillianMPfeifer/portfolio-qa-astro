---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import BaseLayout from '../../layouts/BaseLayout.astro';
import StackList from '../StackList.astro';
import { getAdjacentProjects, projectHref, resolveAltLocaleHref } from '../../utils/projectList';
import { home, type Locale } from '../../data/home';
import { ui } from '../../data/ui';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const locale = project.data.lang as Locale;
const t = ui[locale].projects;
const labels = home[locale].projects;
const { Content } = await render(project);
const allProjects = await getCollection('projects');
const { prev, next } = getAdjacentProjects(allProjects, locale, project.id);
const altLocaleHref = resolveAltLocaleHref(project, allProjects);
---

<BaseLayout title={`Willian Pfeifer — ${project.data.title}`} description={project.data.problem} altLocaleHref={altLocaleHref}>
  <article class="container-page py-12 md:py-16">
    <a href={getRelativeLocaleUrl(locale, '/projects/')} class="text-sm font-semibold">{t.back}</a>
    <header class="mt-6 max-w-[760px]">
      <p class="font-mono text-[0.72rem] text-ink-soft">
        {project.data.role}, {project.data.period}
      </p>
      <h1 class="mt-2 text-[clamp(2rem,5.5vw,3.25rem)]">{project.data.title}</h1>
      <div class="mt-4 flex flex-wrap items-center gap-3">
        <StackList stack={project.data.stack} />
        {
          project.data.url && (
            <a
              href={project.data.url}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-primary inline-flex items-center gap-1.5 text-xs py-1 px-2.5"
            >
              <span>{locale === 'pt' ? 'Ver projeto online' : 'View live project'}</span>
              <span aria-hidden="true">↗</span>
            </a>
          )
        }
      </div>
    </header>

    <dl class="mt-8 grid max-w-[760px] gap-4 rounded-lg bg-surface p-5 sm:grid-cols-2 sm:p-6">
      <div>
        <dt class="font-mono text-[0.7rem] text-ink-soft">{labels.problem}</dt>
        <dd class="mt-1">{project.data.problem}</dd>
      </div>
      <div>
        <dt class="font-mono text-[0.7rem] text-ink-soft">{labels.outcome}</dt>
        <dd class="mt-1 font-semibold text-accent">{project.data.outcome}</dd>
      </div>
    </dl>

    <div class="prose-case mt-4 max-w-[68ch]">
      <Content />
    </div>

    <nav class="mt-14 grid max-w-[760px] gap-4 border-t border-line pt-6 sm:grid-cols-2" aria-label={t.navLabel}>
      <div>
        {
          prev && (
            <a href={projectHref(prev)} class="flex flex-col no-underline">
              <span class="font-mono text-[0.7rem] text-ink-soft">{t.previous}</span>
              <span class="font-semibold text-ink hover:underline">{prev.data.title}</span>
            </a>
          )
        }
      </div>
      <div class="sm:text-right">
        {
          next && (
            <a href={projectHref(next)} class="flex flex-col no-underline sm:items-end">
              <span class="font-mono text-[0.7rem] text-ink-soft">{t.next}</span>
              <span class="font-semibold text-ink hover:underline">{next.data.title}</span>
            </a>
          )
        }
      </div>
    </nav>
  </article>
</BaseLayout>
