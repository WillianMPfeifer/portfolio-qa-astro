---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import StackList from '../StackList.astro';
import { getProjectsByLang, projectHref } from '../../utils/projectList';
import { home, type Locale } from '../../data/home';
import { ui } from '../../data/ui';

const locale = (Astro.currentLocale ?? 'en') as Locale;
const t = ui[locale].projects;
const labels = home[locale].projects;
const projects = getProjectsByLang(await getCollection('projects'), locale);
---

<BaseLayout title={`Willian Pfeifer — ${t.title}`}>
  <div class="container-page py-12 md:py-16">
    <h1 class="text-[clamp(2.25rem,6vw,3.5rem)]">{t.title}</h1>
    <p class="mt-4 max-w-[60ch] text-lg text-ink-soft">{t.intro}</p>
    <ul class="mt-10 border-b border-line">
      {
        projects.map((project) => (
          <li class="relative grid gap-3 border-t border-line py-6 md:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] md:gap-10">
            <div>
              <p class="font-mono text-[0.72rem] text-ink-soft">
                {project.data.role}, {project.data.period}
              </p>
              <h2 class="mt-1.5 text-2xl leading-snug">
                <a href={projectHref(project)} class="text-ink no-underline after:absolute after:inset-0 after:content-[''] hover:underline">
                  {project.data.title}
                </a>
              </h2>
              <div class="mt-3">
                <StackList stack={project.data.stack} />
              </div>
            </div>
            <dl class="grid gap-2 text-[0.95rem]">
              <div>
                <dt class="font-mono text-[0.7rem] text-ink-soft">{labels.problem}</dt>
                <dd>{project.data.problem}</dd>
              </div>
              <div>
                <dt class="font-mono text-[0.7rem] text-ink-soft">{labels.outcome}</dt>
                <dd class="font-semibold text-accent">{project.data.outcome}</dd>
              </div>
            </dl>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>
