---
interface Props {
  stack: string[];
}

const { stack } = Astro.props;
---

<ul class="stack-list">
  {stack.map((tech) => (
    <li>{tech}</li>
  ))}
</ul>

<style>
  .stack-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    margin: 0;
    padding: 0;
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }

  .stack-list li {
    border: 1px solid var(--ink-soft);
    border-radius: 3px;
    padding: 0.15rem 0.5rem;
    color: var(--ink-soft);
  }
</style>
