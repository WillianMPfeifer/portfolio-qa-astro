---
interface Props {
  label: string;
}

const { label } = Astro.props;
---

<button
  id="theme-toggle"
  aria-label={label}
  type="button"
  class="grid size-9 cursor-pointer place-items-center rounded-md border border-line text-ink hover:border-ink"
>
  <!-- Lua no tema claro, sol no tema escuro (troca via CSS, sem JS) -->
  <svg class="theme-icon-moon size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" stroke-linejoin="round"></path>
  </svg>
  <svg class="theme-icon-sun size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" stroke-linecap="round"></path>
  </svg>
</button>

<style>
  .theme-icon-sun {
    display: none;
  }

  :global([data-theme='dark']) .theme-icon-sun {
    display: block;
  }

  :global([data-theme='dark']) .theme-icon-moon {
    display: none;
  }
</style>

<script>
  // Mesma chave de localStorage que o ThemeSelect.astro do Starlight
  // (storeTheme), para o tema ficar sincronizado entre o site principal e /docs.
  const storageKey = 'starlight-theme';

  const button = document.getElementById('theme-toggle');
  button?.addEventListener('click', () => {
    const root = document.documentElement;
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    localStorage.setItem(storageKey, next);
  });
</script>
