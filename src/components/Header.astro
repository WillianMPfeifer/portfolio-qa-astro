---
import { getRelativeLocaleUrl } from 'astro:i18n';
import ThemeToggle from './ThemeToggle.astro';
import { home, type Locale } from '../data/home';

interface Props {
  altLocaleHref?: { pt: string; en: string };
}

const { altLocaleHref } = Astro.props;

const currentLocale = (Astro.currentLocale ?? 'en') as Locale;
const t = home[currentLocale].nav;
const pathWithoutLocale =
  currentLocale === 'en'
    ? Astro.url.pathname
    : Astro.url.pathname.replace(new RegExp(`^/${currentLocale}(?=/|$)`), '') || '/';

const ptHref = altLocaleHref?.pt ?? getRelativeLocaleUrl('pt', pathWithoutLocale);
const enHref = altLocaleHref?.en ?? getRelativeLocaleUrl('en', pathWithoutLocale);

const navLinks = [
  { label: t.projects, href: getRelativeLocaleUrl(currentLocale, '/projects/') },
  { label: t.quality, href: getRelativeLocaleUrl(currentLocale, '/quality') },
  { label: t.docs, href: getRelativeLocaleUrl(currentLocale, '/docs') },
];

const isActive = (href: string) => Astro.url.pathname.replace(/\/$/, '') === href.replace(/\/$/, '');
const langLink = 'no-underline px-1.5 py-0.5 rounded text-ink-soft hover:text-ink';
---

<header class="border-b border-line">
  <div class="container-page flex flex-wrap items-center gap-x-6 gap-y-2 py-4">
    <a href={getRelativeLocaleUrl(currentLocale, '/')} class="font-extrabold tracking-tight text-ink no-underline">
      Willian Pfeifer
    </a>
    <nav aria-label="Site" class="order-last w-full sm:order-none sm:w-auto">
      <ul class="flex gap-5 text-[0.95rem]">
        {
          navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={isActive(link.href) ? 'page' : undefined}
                class="text-ink-soft no-underline hover:text-ink aria-[current=page]:text-ink aria-[current=page]:underline"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="ml-auto flex items-center gap-3">
      <nav aria-label={t.language} class="flex items-center font-mono text-xs">
        <a
          href={ptHref}
          lang="pt-BR"
          aria-current={currentLocale === 'pt' ? 'page' : undefined}
          class:list={[langLink, 'aria-[current=page]:bg-surface aria-[current=page]:text-ink']}>pt</a
        >
        <a
          href={enHref}
          lang="en"
          aria-current={currentLocale === 'en' ? 'page' : undefined}
          class:list={[langLink, 'aria-[current=page]:bg-surface aria-[current=page]:text-ink']}>en</a
        >
      </nav>
      <ThemeToggle label={t.themeToggle} />
    </div>
  </div>
</header>
