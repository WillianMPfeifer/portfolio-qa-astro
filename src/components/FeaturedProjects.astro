---
import { getCollection } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { selectFeaturedProjects } from '../utils/featuredProjects';
import { projectHref } from '../utils/projectList';
import { home, type Locale } from '../data/home';
import StackList from './StackList.astro';
import { links } from '../data/links';

const locale = (Astro.currentLocale ?? 'en') as Locale;
const t = home[locale].projects;
const allProjects = await getCollection('projects');
const featured = selectFeaturedProjects(allProjects, locale);
---

{
  featured.length > 0 && (
    <section class="container-page py-16 md:py-20" aria-labelledby="featured-projects-heading">
      <p class="section-label">{t.label}</p>
      <h2 id="featured-projects-heading" class="mt-3 text-[clamp(1.75rem,4vw,2.5rem)]">
        {t.title}
      </h2>
      <ul class="mt-10 grid gap-6 md:grid-cols-2">
        {featured.map((project) => (
          <li class="relative flex flex-col gap-4 rounded-lg border border-line p-6 transition-colors hover:border-ink-soft">
            <h3 class="text-xl leading-snug">
              <a href={projectHref(project)} class="text-ink no-underline after:absolute after:inset-0 after:content-['']">
                {project.data.title}
              </a>
            </h3>
            <dl class="grid gap-3 text-[0.95rem]">
              <div>
                <dt class="font-mono text-[0.7rem] text-ink-soft">{t.problem}</dt>
                <dd>{project.data.problem}</dd>
              </div>
              <div>
                <dt class="font-mono text-[0.7rem] text-ink-soft">{t.outcome}</dt>
                <dd class="font-semibold text-accent">{project.data.outcome}</dd>
              </div>
            </dl>
            <div class="mt-auto flex flex-wrap items-center justify-between gap-3 pt-2">
              <StackList stack={project.data.stack} />
              <span class="text-sm font-semibold text-ink" aria-hidden="true">
                {t.readCase}
              </span>
            </div>
          </li>
        ))}
      </ul>
      <a class="mt-8 inline-block font-semibold" href={getRelativeLocaleUrl(locale, '/projects/')}>
        {t.seeAll}
      </a>
      <p class="mt-6 max-w-[70ch] text-[0.95rem] text-ink-soft">
        {t.freelance.before}<a href={links.anibem}>{t.freelance.link}</a>{t.freelance.middle}<a href={links.lavaCenter}>{t.freelance.secondLink}</a>{t.freelance.after}
      </p>
    </section>
  )
}
