---
import { home, type Locale } from '../../data/home';

const locale = (Astro.currentLocale ?? 'en') as Locale;
const t = home[locale].beyond;
---

<section class="bg-surface" aria-labelledby="beyond-heading">
  <div class="container-page grid gap-10 py-16 md:py-20 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-14">
    <div>
      <p class="section-label">{t.label}</p>
      <h2 id="beyond-heading" class="mt-3 text-[clamp(1.6rem,3.5vw,2.25rem)]">{t.title}</h2>
      <p class="mt-4 text-ink-soft">{t.intro}</p>
    </div>
    <ul class="grid gap-x-8 sm:grid-cols-2">
      {
        t.items.map((item) => (
          <li class="flex gap-3 border-t border-line py-4 text-[0.98rem] leading-relaxed">
            <span class="mt-[0.6em] size-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true" />
            <span>{item}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>
