---
import { home, type Locale } from '../../data/home';

const locale = (Astro.currentLocale ?? 'en') as Locale;
const t = home[locale].proof;
---

<section class="container-page pb-16" aria-labelledby="proof-heading">
  <h2 id="proof-heading" class="section-label mb-4 font-normal tracking-normal">{t.label}</h2>
  <dl class="grid grid-cols-2 gap-x-4 border-t border-line lg:grid-cols-4">
    {
      t.items.map((item) => (
        <div class="flex flex-col gap-1 border-b border-line py-5 sm:pr-6 lg:border-b-0">
          <dt class="order-2 text-[0.95rem] leading-snug text-ink">{item.label}</dt>
          <dd class="order-1 text-[1.6rem] font-extrabold sm:text-[2rem] leading-none tracking-[-0.03em] text-ink">{item.value}</dd>
          <dd class="order-3 mt-1 font-mono text-[0.7rem] text-honey">{item.source}</dd>
        </div>
      ))
    }
  </dl>
</section>
