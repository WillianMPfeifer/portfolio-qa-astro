---
import { home, type Locale } from '../../data/home';
import { links } from '../../data/links';

const locale = (Astro.currentLocale ?? 'en') as Locale;
const t = home[locale].incident;
const kw = 'font-semibold text-band-honey';
---

<section class="bg-band text-band-ink" aria-labelledby="incident-heading">
  <div class="container-page grid gap-10 py-16 md:py-20 lg:grid-cols-[minmax(0,5fr)_minmax(0,6fr)] lg:gap-14">
    <div>
      <p class="font-mono text-xs text-band-soft">{t.label}</p>
      <h2 id="incident-heading" class="mt-3 text-[clamp(1.75rem,4vw,2.5rem)] text-band-ink">{t.title}</h2>
      <p class="mt-5 text-lg leading-relaxed text-band-ink">{t.body}</p>
      <p class="mt-5 text-sm text-band-soft">
        {t.note.before}<a href={links.incidentPost} class="text-band-ink">{t.note.link}</a>{t.note.after}
      </p>
    </div>

    <figure
      class="incident-report self-start rounded-lg border border-white/15 bg-black/20 p-5 font-mono text-[0.78rem] leading-[1.9] sm:p-6"
      data-incident-report
    >
      <div>
        {t.languageTag && <p class="text-band-soft">{t.languageTag}</p>}
        <p><span class={kw}>{t.feature.keyword}:</span> {t.feature.text}</p>
        <p class="mt-[1.9em] pl-[2ch]"><span class={kw}>{t.scenario.keyword}:</span> {t.scenario.text}</p>
        {
          t.steps.map((step) => (
            <p class="pl-[4ch]">
              <span class={kw}>{step.keyword}</span> {step.text}
            </p>
          ))
        }
      </div>
      <table class="mt-2 ml-[6ch] border-collapse">
        <thead>
          <tr class="text-band-soft">
            <th scope="col" class="pr-6 text-left font-normal">| {t.table.header[0]}</th>
            <th scope="col" class="pr-2 text-left font-normal">| {t.table.header[1]} |</th>
          </tr>
        </thead>
        <tbody>
          {
            t.table.rows.map((row, i) => (
              <tr>
                <td class="pr-6 text-band-soft">
                  | <span class="text-band-ink">{row}</span>
                </td>
                <td class="pr-2 text-band-soft">
                  | <span class="result inline-block text-band-passed" style={`--i:${i}`}>✓ {t.table.passed}</span>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </figure>
  </div>
</section>

<style>
  /* Assinatura da página: os resultados viram "passou" em sequência quando a faixa aparece.
     Sem JS ou com movimento reduzido, a tabela já aparece pronta. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) [data-incident-report]:not(.is-visible) .result {
      opacity: 0;
      transform: translateX(-4px);
    }

    .result {
      transition:
        opacity 0.3s ease-out,
        transform 0.3s ease-out;
      transition-delay: calc(var(--i) * 0.45s + 0.2s);
    }
  }
</style>

<script>
  const report = document.querySelector('[data-incident-report]');
  if (report) {
    const observer = new IntersectionObserver(
      (entries) => {
        if (entries.some((entry) => entry.isIntersecting)) {
          report.classList.add('is-visible');
          observer.disconnect();
        }
      },
      { threshold: 0.5 },
    );
    observer.observe(report);
  }
</script>
